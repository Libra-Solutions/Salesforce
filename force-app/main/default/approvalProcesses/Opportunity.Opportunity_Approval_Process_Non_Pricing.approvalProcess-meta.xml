<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Recommend_Pricing__c</field>
        <field>Comments__c</field>
        <field>Current_Pricing__c</field>
        <field>Recommended_Pricing_ID__c</field>
        <field>Deal_Type__c</field>
        <field>Decision_Date__c</field>
        <field>Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>dateForFirstApproval</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Decision_Date_Updated_with_Todays_date</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>getFristApproval</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>isSubmitted_False</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Non_Pricing</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opp_Status</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opportunity_approval_email</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Updated_Stage_Value</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>clawler@movedocs.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>rcutlip@movedocs.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>sbattu@oasisfinancial.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Opportunity Sizing Approval Process</label>
        <name>Opportunity_Sizing_Approval_Process</name>
        <rejectionActions>
            <action>
                <name>Decision_Date_Updated_Non_BP</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opp_Status_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opportunity_rejection_level_one</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>unfiled$public/Notification_of_Approval</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.RecordType</field>
            <operation>equals</operation>
            <value>Sizing the Opportunity</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.What_would_it_take_to_get_the_additional__c</field>
            <operation>excludes</operation>
            <value>Better Pricing</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>isSubmitted_true</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Stage_Update</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Status</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Opportunity Approval Process Non Pricing</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
