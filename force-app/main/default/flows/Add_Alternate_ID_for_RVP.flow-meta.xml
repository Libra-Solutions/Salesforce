    <description>Adds the RVP to the Alternate ID field for Account Engagement, based on the Billing State of the Account.
Set Alternative ID as the Assigned BDE if the owner is not the API Only User</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns the region based on the state of the account</description>
        <name>RegionbasedonState</name>
        <dataType>String</dataType>
        <expression>IF(
    OR(
        {!$Record.Account.Billing_State__c} = &quot;AZ&quot;,
        {!$Record.Account.Billing_State__c} = &quot;CA&quot;,
        {!$Record.Account.Billing_State__c} = &quot;CO&quot;,
        {!$Record.Account.Billing_State__c} = &quot;NM&quot;,
        {!$Record.Account.Billing_State__c} = &quot;NV&quot;,
        {!$Record.Account.Billing_State__c} = &quot;OR&quot;,
        {!$Record.Account.Billing_State__c} = &quot;UT&quot;,
        {!$Record.Account.Billing_State__c} = &quot;WA&quot;
    ),
    &quot;Western&quot;,
    IF(
        OR(
            {!$Record.Account.Billing_State__c} = &quot;AR&quot;,
            {!$Record.Account.Billing_State__c} = &quot;LA&quot;,
            {!$Record.Account.Billing_State__c} = &quot;MS&quot;,
            {!$Record.Account.Billing_State__c} = &quot;OK&quot;,
            {!$Record.Account.Billing_State__c} = &quot;TX&quot;
        ),
        &quot;Southern&quot;,
  IF(
        OR(
            {!$Record.Account.Billing_State__c} = &quot;AL&quot;,
            {!$Record.Account.Billing_State__c} = &quot;FL&quot;,
            {!$Record.Account.Billing_State__c} = &quot;GA&quot;
        ),
        &quot;Southeast&quot;,
IF(
        OR(
            {!$Record.Account.Billing_State__c} = &quot;DC&quot;,
            {!$Record.Account.Billing_State__c} = &quot;MD&quot;,
            {!$Record.Account.Billing_State__c} = &quot;NC&quot;,
            {!$Record.Account.Billing_State__c} = &quot;SC&quot;,
            {!$Record.Account.Billing_State__c} = &quot;VA&quot;,
            {!$Record.Account.Billing_State__c} = &quot;TN&quot;
        ),
        &quot;Mid-Altantic&quot;,
IF(
        OR(
            {!$Record.Account.Billing_State__c} = &quot;DE&quot;,
            {!$Record.Account.Billing_State__c} = &quot;IA&quot;,
            {!$Record.Account.Billing_State__c} = &quot;IL&quot;,
            {!$Record.Account.Billing_State__c} = &quot;IN&quot;,
            {!$Record.Account.Billing_State__c} = &quot;MA&quot;,
            {!$Record.Account.Billing_State__c} = &quot;MI&quot;,
            {!$Record.Account.Billing_State__c} = &quot;MN&quot;,
            {!$Record.Account.Billing_State__c} = &quot;MO&quot;,
            {!$Record.Account.Billing_State__c} = &quot;NJ&quot;,
            {!$Record.Account.Billing_State__c} = &quot;NY&quot;,
            {!$Record.Account.Billing_State__c} = &quot;OH&quot;,
            {!$Record.Account.Billing_State__c} = &quot;PA&quot;,
            {!$Record.Account.Billing_State__c} = &quot;RI&quot;,
            {!$Record.Account.Billing_State__c} = &quot;CT&quot;,
            {!$Record.Account.Billing_State__c} = &quot;WI&quot;
        ),
        &quot;Midwest-Northeast&quot;,
IF(
        OR(
            {!$Record.Account.Billing_State__c} = &quot;KY&quot;,
            {!$Record.Account.Billing_State__c} = &quot;ME&quot;,
            {!$Record.Account.Billing_State__c} = &quot;HI&quot;,
            {!$Record.Account.Billing_State__c} = &quot;KS&quot;,
            {!$Record.Account.Billing_State__c} = &quot;NE&quot;,
            {!$Record.Account.Billing_State__c} = &quot;SD&quot;,
            {!$Record.Account.Billing_State__c} = &quot;NH&quot;
        ),
        &quot;Misc-Graubert&quot;,
IF(
        OR(
            {!$Record.Account.Billing_State__c} = &quot;WV&quot;,
            {!$Record.Account.Billing_State__c} = &quot;IA&quot;,
            {!$Record.Account.Billing_State__c} = &quot;CT&quot;
        ),
        &quot;Misc-Lawler&quot;,
        &quot;Non-Served&quot;
    )
)
)
)
)
)
)</expression>
