    <recordLookups>
        <description>Get all Contacts where:
- Record type Move Docs User 
- MD User Last Login Date is prior to 90 days ago
- MD InactivityTaskId is blank 
- CMS Integrated with MoveDocs is YES
- Onwer is not the API Only User</description>
        <name>Get_Contacts_Not_Logged_In_for_90_Days</name>
        <label>Get Contacts Not Logged In for 90 Days</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Contacts_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4) AND 5 AND 6</filterLogic>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Move_Docs_User_Contact_Recordtype.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>MD_User_Last_Login_Date__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>NintyDaysAgo</elementReference>
            </value>
        </filters>
        <filters>
            <field>MD_InactivityTaskId__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>MD_InactivityTaskId__c</field>
            <operator>EqualTo</operator>
        </filters>
        <filters>
            <field>CMS_Integrated_with_MoveDocs__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Yes</stringValue>
            </value>
        </filters>
        <filters>
            <field>OwnerId</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>0054M000003ia3mQAA</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <limit>
            <numberValue>600.0</numberValue>
        </limit>
        <object>Contact</object>
        <sortField>MD_User_Last_Login_Date__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
