        </connector>
    </assignments>
    <customErrors>
        <name>Level_2_Other_Results_Required</name>
        <label>Level 2 Other Results Required</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>When Level 2 Results are indicated as Other, you must fill in those results in this field.</errorMessage>
            <fieldSelection>Level_2_Results_Other__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Level_2_Results_Not_Filled_In</name>
        <label>Level 2 Results Not Filled In</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>When the result of an activity is a Level 2, you must fill in the Level 2 Results Field.</errorMessage>
            <fieldSelection>Level_2_Results__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Is_Account_Empty</name>
        <label>Is Account Empty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Is_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Record</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account_Record.CMS_Integrated_with_MoveDocs__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Level_2_Results</targetReference>
            </connector>
            <label>Account Is Not Empty and is integrated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Level_2_Results</name>
        <label>Is Level 2 Results?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Level_2_Results</name>
            <conditionLogic>(1 OR 2 OR 3) AND 4</conditionLogic>
            <conditions>
                <leftValueReference>IsLevel2Result</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Oasis_Event_Result__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Level Two</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Oasis_Event_Result__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Level 2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_2_Results__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Level_2_Results_Not_Filled_In</targetReference>
            </connector>
            <label>Level 2 Results</label>
        </rules>
        <rules>
            <name>Level_2_Results_Other_Not_Filled_In</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Oasis_Event_Result__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Level 2</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Oasis_Event_Result__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Level Two</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_2_Results__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Other</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Level_2_Results_Other__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Level_2_Other_Results_Required</targetReference>
            </connector>
            <label>Level 2 Results Other Not Filled In</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Related_To_Empty</name>
        <label>Related To Empty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Related_To_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhatId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Account_ID</targetReference>
            </connector>
            <label>Related To Not Empty</label>
        </rules>
        <rules>
            <name>Related_To_Empty_Who_Id_Not_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.WhoId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contact</targetReference>
            </connector>
            <label>Related To Empty, Who Id Not Empty</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsLevel2Result</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(TEXT({!$Record.Oasis_Event_Result__c}), &quot;Level Two&quot;)</expression>
    </formulas>
