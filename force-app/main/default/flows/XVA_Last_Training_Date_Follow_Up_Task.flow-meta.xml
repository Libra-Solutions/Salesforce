            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X60_Days_After</name>
            <connector>
                <targetReference>Get_Ownership_Routings</targetReference>
            </connector>
            <label>60 Days After</label>
            <offsetNumber>60</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X90_Days_After</name>
            <connector>
                <targetReference>Get_Ownership_Routings</targetReference>
            </connector>
            <label>90 Days After</label>
            <offsetNumber>90</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <scheduledPaths>
            <name>X120_Days_After</name>
            <connector>
                <targetReference>Get_Ownership_Routings</targetReference>
            </connector>
            <label>120 Days After</label>
            <offsetNumber>120</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
