    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_State_TX</name>
        <label>Is State TX?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>State Is Not TX</defaultConnectorLabel>
        <rules>
            <name>State_Is_TX</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact.MailingState</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>&quot;TX&quot;</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Account.BillingState</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>&quot;TX&quot;</stringValue>
                </rightValue>
            </conditions>
            <label>State Is TX</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Account_Found</name>
        <label>Was Account Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Account Not Found</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Where_is_State</targetReference>
            </connector>
            <label>Account Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Contact_Record_Found</name>
