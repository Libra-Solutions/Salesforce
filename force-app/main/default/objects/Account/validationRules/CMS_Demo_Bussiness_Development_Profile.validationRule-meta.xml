<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CMS_Demo_Bussiness_Development_Profile</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
$Profile.Name = &quot;Business Development&quot;,
ISBLANK(TEXT(CMS_Demo__c)),
NOT(ISCHANGED( Account_Last_Event_Date__c ))
)</errorConditionFormula>
    <errorDisplayField>CMS_Demo__c</errorDisplayField>
    <errorMessage>CMS Demo selection is required for Business Development users</errorMessage>
</ValidationRule>
