<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrice_C3_Account_Name_Edit</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Name),
    $User.Alias != &quot;apionly&quot;
)</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>The Account Name cannot be edited. Only the API user ma update this field.</errorMessage>
</ValidationRule>
