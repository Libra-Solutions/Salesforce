<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Firm_name_postal_code_validation_rule</fullName>
    <active>false</active>
    <errorConditionFormula>NOT(
    REGEX( Postal_Code__c , &quot;^[0-9]{5}$&quot; )
)</errorConditionFormula>
    <errorDisplayField>Firm_Address__PostalCode__s</errorDisplayField>
    <errorMessage>Postal Code must be exactly 5 numeric digits.</errorMessage>
</ValidationRule>
