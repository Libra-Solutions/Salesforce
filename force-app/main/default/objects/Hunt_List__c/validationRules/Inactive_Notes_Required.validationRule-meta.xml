<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Inactive_Notes_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Inactive&quot;),
    ISPICKVAL(Inactive_Reason__c, &quot;Other&quot;),
    ISBLANK(Inactive_Notes__c)
)</errorConditionFormula>
    <errorMessage>Inactive Notes are required when Inactive Reason is Other.</errorMessage>
</ValidationRule>
