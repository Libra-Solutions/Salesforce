<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Inactive_Status_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Inactive&quot;),
    ISPICKVAL(Inactive_Reason__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>Inactive_Reason__c</errorDisplayField>
    <errorMessage>Please Select Inactive Reason.</errorMessage>
</ValidationRule>
