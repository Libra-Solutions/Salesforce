<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Annual_Esti_Mandatory_during_conversion</fullName>
    <active>true</active>
    <errorConditionFormula>AND( 
IsConverted, 
IsBlank( Annual_Estimate__c ),
RecordType.DeveloperName = &apos;Provider&apos;
)</errorConditionFormula>
    <errorDisplayField>Annual_Estimate__c</errorDisplayField>
    <errorMessage>Please enter annual estimate to convert the lead.</errorMessage>
</ValidationRule>
