<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Reason_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(IsPickVal(Status,&apos;Unqualified&apos;),IsPickVal( Unqualified_Reason__c ,&apos;Other&apos;),IsBlank( Other_Reason__c ))</errorConditionFormula>
    <errorDisplayField>Other_Reason__c</errorDisplayField>
    <errorMessage>Please enter other reason for unqualified.</errorMessage>
</ValidationRule>
