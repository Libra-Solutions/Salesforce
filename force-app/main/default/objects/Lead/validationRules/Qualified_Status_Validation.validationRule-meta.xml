<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Qualified_Status_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND( 
IsConverted, 
NOT(TEXT(PRIORVALUE(Status)) = &quot;Qualified&quot;) 
)</errorConditionFormula>
    <errorMessage>Lead status must be qualified before conversion.</errorMessage>
</ValidationRule>
