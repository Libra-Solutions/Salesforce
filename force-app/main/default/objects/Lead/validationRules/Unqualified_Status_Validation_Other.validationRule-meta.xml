<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Unqualified_Status_Validation_Other</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISPICKVAL(Status, &apos;Unqualified&apos;) ,IsBlank( Description ) , ISPICKVAL(Unqualified_Reason__c,&apos;Other&apos;) )</errorConditionFormula>
    <errorDisplayField>Description</errorDisplayField>
    <errorMessage>Please enter the disqualification reason in the comments box.</errorMessage>
</ValidationRule>
