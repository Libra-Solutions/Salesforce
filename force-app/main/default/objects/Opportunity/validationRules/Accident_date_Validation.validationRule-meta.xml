<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Accident_date_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
Accident_Date__c &gt; TODAY()
)</errorConditionFormula>
    <errorMessage>&apos;Accident Date&apos; should not be a future date</errorMessage>
</ValidationRule>
