<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Closed_Lost_Reason_other</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL(StageName, &apos;Closed Lost&apos;) ,  ISPICKVAL(Closed_Lost_Reason__c, &apos;Other&apos;),  ISBLANK(  Other_Reason__c)  )</errorConditionFormula>
    <errorDisplayField>Other_Reason__c</errorDisplayField>
    <errorMessage>Please enter Closed Lost-Other reason.</errorMessage>
</ValidationRule>
