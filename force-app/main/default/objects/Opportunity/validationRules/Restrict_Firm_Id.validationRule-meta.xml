<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Firm_Id</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISNEW(),
RecordType.Name = &apos;Sizing the Opportunity&apos;,
ISNULL(Firm_Id__c )
)</errorConditionFormula>
    <errorDisplayField>Firm_Id__c</errorDisplayField>
    <errorMessage>Firm Id Should be null</errorMessage>
</ValidationRule>
