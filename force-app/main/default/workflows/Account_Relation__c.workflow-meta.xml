<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Send_mail_to_Attorney</fullName>
        <description>Send mail to Attorney</description>
        <protected>false</protected>
        <recipients>
            <type>accountOwner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Email_Template_for_Attorney_Provider</template>
    </alerts>
    <alerts>
        <fullName>Send_mail_to_Physician</fullName>
        <description>Send mail to Physician</description>
        <protected>false</protected>
        <recipients>
            <type>accountOwner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/Email_Template_for_Attorney_Provider</template>
    </alerts>
    <rules>
        <fullName>Attorney%2FProvider Attorney Creation</fullName>
        <actions>
            <name>Send_mail_to_Attorney</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Account_Relation__c.Created_from_backend__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Relation__c.Role__c</field>
            <operation>equals</operation>
            <value>Attorney</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Attorney%2FProvider Physician Creation</fullName>
        <actions>
            <name>Send_mail_to_Physician</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Account_Relation__c.Created_from_backend__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Account_Relation__c.Role__c</field>
            <operation>equals</operation>
            <value>Physician</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
