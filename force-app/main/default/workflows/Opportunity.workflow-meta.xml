        </actions>
        <actions>
            <name>When_Opportunity_created</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <formula>AND(RecordType.Name = &apos;Sizing the Opportunity&apos;,   ISPICKVAL(StageName, &apos;Submitted opportunity&apos;), isChanged(StageName))</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
