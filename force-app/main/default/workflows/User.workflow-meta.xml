<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Reminder_email_templates_for_when_new_Inside_or_Outside_user_is_added</fullName>
        <description>Reminder email templates for when new Inside or Outside user is added</description>
        <protected>false</protected>
        <recipients>
            <recipient>apriyatmo@oasisfinancial.com</recipient>
            <type>user</type>
        </recipients>
        <recipients>
            <recipient>sbattu@oasisfinancial.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/New_Inside_Sales_Team_Member_Added</template>
    </alerts>
    <alerts>
        <fullName>Reminder_email_templates_for_when_new_Outside_user_is_added</fullName>
        <description>Reminder email templates for when new Outside user is added</description>
        <protected>false</protected>
        <recipients>
            <recipient>apriyatmo@oasisfinancial.com</recipient>
            <type>user</type>
        </recipients>
        <recipients>
            <recipient>sbattu@oasisfinancial.com</recipient>
            <type>user</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>unfiled$public/New_Outside_Sales_Team_Member_Added</template>
    </alerts>
    <rules>
        <fullName>Send email when Inside Sales user created</fullName>
        <actions>
            <name>Reminder_email_templates_for_when_new_Inside_or_Outside_user_is_added</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>User.ProfileId</field>
            <operation>equals</operation>
            <value>Inside Sales</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Send email when outside user created</fullName>
        <actions>
            <name>Reminder_email_templates_for_when_new_Outside_user_is_added</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>User.ProfileId</field>
            <operation>equals</operation>
            <value>Outside Sales</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
